{
  "name": "topcoder-member-api",
  "version": "1.0.0",
  "description": "TopCoder Member V6 API",
  "main": "dist/main.js",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "postinstall": "pnpm run prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma --generator client && prisma generate --schema=prisma/identity-schema.prisma --generator identityClient && prisma generate --schema=prisma/challenge-schema.prisma --generator challengeClient",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint --no-error-on-unmatched-pattern \"*.ts\" \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "init-db": "prisma migrate dev",
    "clear-db": "ts-node src/scripts/clear-tables.ts",
    "download-data": "ts-node src/scripts/download.ts",
    "seed-data": "ts-node src/scripts/seed-data.ts",
    "reset-db": "prisma migrate reset",
    "test": "NODE_ENV=test mocha -t 20000 --require ts-node/register/transpile-only test/unit/*.test.js --exit",
    "test:cov": "nyc --reporter=html --reporter=text pnpm test",
    "migrate-dynamo-data": "ts-node src/scripts/migrate-dynamo-data.ts",
    "recalculate-member-stats": "node --require ts-node/register/transpile-only src/scripts/recalculateMemberStats.js",
    "backfill-challenge-results": "ts-node src/scripts/backfillChallengeResults.ts",
    "dedupe-marathon-match-history": "ts-node src/scripts/dedupeMarathonMatchHistory.ts",
    "rerate-rating-path": "ts-node src/scripts/rerateRatingPath.ts",
    "rerate-marathon-matches": "ts-node src/scripts/rerateMarathonMatches.ts",
    "rerate-development-challenge": "ts-node src/scripts/rerateDevelopmentChallenge.ts",
    "update-member-traits": "ts-node src/scripts/update-member-traits.ts",
    "verify-stats-migration": "ts-node src/scripts/verifyStatsMigration.ts",
    "member-jwt": "ts-node src/scripts/member-jwt.ts"
  },
  "author": "TCSCODER",
  "license": "none",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "aws-sdk-mock": "^6.2.1",
    "chai": "^4.2.0",
    "chai-http": "^4.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "mocha": "^11.7.0",
    "mocha-prepare": "^0.1.0",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@prisma/client-runtime-utils": "7.4.2",
    "@react-pdf/renderer": "^3.4.4",
    "@topcoder/challenge-api-v6": "github:topcoder-platform/challenge-api-v6#master",
    "@topcoder/engagements-api-v6": "topcoder-platform/engagements-api-v6.git#master",
    "@topcoder/learning-paths-api": "github:topcoder-platform/learning-paths-api#master",
    "@topcoder/resource-api-v6": "topcoder-platform/resource-api-v6.git#master",
    "@topcoder/standardized-skills-api": "topcoder-platform/standardized-skills-api.git#master",
    "@topcoder/tc-finance-api": "topcoder-platform/tc-finance-api.git#master",
    "@topcoder/tc-identity-service": "topcoder-platform/identity-api-v6.git#master",
    "aws-sdk": "^2.466.0",
    "axios": "^0.27.2",
    "bluebird": "^3.5.1",
    "body-parser": "^1.15.1",
    "city-timezones": "^1.3.2",
    "config": "^3.0.1",
    "cors": "^2.7.1",
    "country-calling-code": "^0.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.15.4",
    "express-fileupload": "^1.1.4",
    "express-interceptor": "^1.2.0",
    "file-type": "^16.5.4",
    "file-type-checker": "^1.1.2",
    "get-parameter-names": "^0.3.0",
    "http-status-codes": "^1.3.0",
    "joi": "^14.0.0",
    "jsonwebtoken": "^8.3.0",
    "lodash": "^4.17.19",
    "mime-types": "^2.1.35",
    "moment": "^2.27.0",
    "moment-timezone": "^0.5.43",
    "mysql2": "^3.14.3",
    "pg": "^8.16.3",
    "prisma": "7.4.2",
    "qs": "^6.14.1",
    "react": "^18.3.1",
    "react-pdf-html": "^2.1.5",
    "reflect-metadata": "^0.2.2",
    "request": "^2.88.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.1",
    "swagger-ui-express": "^5.0.1",
    "tc-core-library-js": "topcoder-platform/tc-core-library-js.git#master",
    "topcoder-bus-api-wrapper": "topcoder-platform/tc-bus-api-wrapper.git",
    "uuid": "^3.3.2",
    "winston": "^3.1.0",
    "yamljs": "^0.3.0"
  },
  "engines": {
    "node": "22.x"
  },
  "volta": {
    "node": "22.x"
  }
}
